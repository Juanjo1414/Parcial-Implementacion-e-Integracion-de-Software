# Copia este archivo a ".env" y completa los valores reales.
# ".env" nunca se sube al repositorio (ver .gitignore).

DB_HOST=db
DB_PORT=5432
DB_NAME=camelracing_db
DB_USERNAME=postgres
DB_PASSWORD=changeme

# Genera un secreto propio antes de desplegar, nunca reutilices este valor de ejemplo:
#   openssl rand -base64 64
JWT_SECRET=changeme-generate-your-own-secret-with-openssl-rand-base64-64
JWT_EXPIRATION=3600000

SERVER_PORT=8080
FRONTEND_PORT=3000

# URL base que el frontend usa para llamar a la API (build-time de Vite / runtime de Nginx).
API_BASE_URL=http://localhost:8080/api
